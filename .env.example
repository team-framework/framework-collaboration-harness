# GitHub fine-grained token: target repositories의 Issues, Pull requests, Contents를 읽을 수 있어야 해요.
GITHUB_TOKEN=

# Framework Bot 토큰이에요. 절대 저장소에 넣지 마세요.
DISCORD_BOT_TOKEN=

# 쉼표로 구분한 감시 대상 저장소예요.
TARGET_REPOSITORIES=team-framework/innolive-client,team-framework/innolive-server,team-framework/innolive-ai

# 기존 지연 알림과 별개로 실시간 GitHub 활동을 받을 저장소예요.
GITHUB_ACTIVITY_REPOSITORIES=team-framework/innolive-client,team-framework/innolive-server,team-framework/innolive-ai,team-framework/framework-collaboration-harness

# 전용 read-only GitHub App의 Webhook secret이에요.
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_HOST=0.0.0.0
GITHUB_WEBHOOK_PORT=3006
GITHUB_WEBHOOK_PATH=/github/webhooks
GITHUB_WEBHOOK_STATE_PATH=.runtime/github-webhook-state.json

# 저장소별 Discord 활동 채널 ID예요.
# 예: {"team-framework/innolive-client":"123456789012345678"}
DISCORD_ACTIVITY_CHANNELS_JSON={}

# GitHub 사용자와 개인 Discord 알림 채널의 연결 정보예요.
# 예: [{"github":"chaeyn","userId":"123456789012345678","channelId":"123456789012345678"}]
DISCORD_RECIPIENTS_JSON=[]

# 일일 요약에서만 멘션할 Framework Team 역할 ID예요.
DISCORD_TEAM_ROLE_ID=
DISCORD_TEAM_CHANNEL_ID=

# /스레드-정리 명령에서 사용하는 OpenAI API 설정이에요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# 중복 알림 방지 상태 파일 경로예요. 장기 실행 환경에서는 영속 볼륨 경로를 지정해 주세요.
ALERT_STATE_PATH=.runtime/alert-state.json
